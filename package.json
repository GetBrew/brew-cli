{
  "name": "@brew.new/cli",
  "version": "0.22.0",
  "description": "Official agent-first command-line interface for the Brew public API.",
  "license": "MIT",
  "author": "Brew",
  "homepage": "https://github.com/GetBrew/brew-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetBrew/brew-cli.git"
  },
  "bugs": {
    "url": "https://github.com/GetBrew/brew-cli/issues"
  },
  "keywords": [
    "brew",
    "brew.new",
    "cli",
    "email",
    "marketing",
    "agent",
    "api",
    "mcp",
    "model-context-protocol",
    "transactional-email",
    "resend",
    "resend-alternative",
    "react-email",
    "ai-agent",
    "agents",
    "auth-emails"
  ],
  "type": "module",
  "bin": {
    "brew-cli": "dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "tsc": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run tests/parity-sdk.test.ts tests/parity-spec.test.ts",
    "check": "bun run tsc && bun run lint && bun run test && bun run docs:commands:check && bun run generate:skills:check && bun run sync:launchers:check",
    "docs:commands": "bun run scripts/generate-command-docs.ts",
    "docs:commands:check": "bun run scripts/generate-command-docs.ts --check",
    "generate:types": "node scripts/generate-types.mjs",
    "generate:skills": "bun run scripts/generate-skills.ts",
    "generate:skills:check": "bun run scripts/generate-skills.ts --check",
    "prepublishOnly": "bun run clean && bun run tsc && bun run lint && bun run test && bun run generate:skills:check && bun run build",
    "smoke:signals": "bun run scripts/signal-smoke.ts",
    "smoke:regressions": "bun run scripts/regression-smoke.ts",
    "sync:launchers": "bun run scripts/sync-launchers.ts",
    "sync:launchers:check": "bun run scripts/sync-launchers.ts --check",
    "smoke:launchers": "bun run scripts/smoke-launchers.ts"
  },
  "dependencies": {
    "@brew.new/sdk": "^13.3.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^25.5.0",
    "msw": "^2.13.2",
    "openapi-typescript": "7.13.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "yaml": "^2.8.0"
  },
  "packageManager": "bun@1.3.10",
  "trustedDependencies": [
    "@brew.new/sdk"
  ]
}
