{
  "name": "@brew.new/cli",
  "version": "0.19.0",
  "description": "Official agent-first command-line interface for the Brew public API.",
  "license": "MIT",
  "author": "Brew",
  "homepage": "https://github.com/GetBrew/brew-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GetBrew/brew-cli.git"
  },
  "bugs": {
    "url": "https://github.com/GetBrew/brew-cli/issues"
  },
  "keywords": [
    "brew",
    "brew.new",
    "cli",
    "email",
    "marketing",
    "agent",
    "api"
  ],
  "type": "module",
  "bin": {
    "brew-cli": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "tsc": "tsc --noEmit",
    "lint": "biome check . && bun run comments:check",
    "fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity": "vitest run tests/parity-sdk.test.ts tests/parity-spec.test.ts",
    "check": "bun run tsc && bun run lint && bun run test",
    "docs:commands": "bun run scripts/generate-command-docs.ts",
    "docs:commands:check": "bun run scripts/generate-command-docs.ts --check",
    "generate:types": "node scripts/generate-types.mjs",
    "prepublishOnly": "bun run clean && bun run tsc && bun run lint && bun run test && bun run build",
    "smoke:signals": "bun run scripts/signal-smoke.ts",
    "smoke:regressions": "bun run scripts/regression-smoke.ts",
    "comments:check": "node --test scripts/source-comments.test.mjs scripts/comments-check.test.mjs && node scripts/check-comments.mjs",
    "comments:setup": "python3 -m pip install --require-hashes --only-binary=:all: --no-deps --upgrade --target node_modules/.comment-parsers -r scripts/comment-parsers.txt"
  },
  "dependencies": {
    "@brew.new/sdk": "git+https://github.com/GetBrew/typescript-sdk.git#f63f1f65f28b82524f590b55da4e17495d596550",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^25.5.0",
    "msw": "^2.13.2",
    "openapi-typescript": "7.13.0",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2",
    "yaml": "^2.8.0",
    "unified": "11.0.5",
    "remark-parse": "11.0.0",
    "remark-mdx": "3.1.1",
    "remark-gfm": "4.0.1"
  },
  "packageManager": "bun@1.3.10",
  "trustedDependencies": [
    "@brew.new/sdk"
  ]
}
